{% comment %}
  Unified certificates entry renderer for both formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      {% if entry.icon %}
        {% if entry.icon contains 'assets/img/' %}
          <img
            src="{{ entry.icon | relative_url }}"
            class="cv-certificate-logo"
            style="width: 22px; height: 22px; margin-right: 8px; object-fit: contain; vertical-align: middle;"
          >
        {% else %}
          <i class="{{ entry.icon }}"></i>
        {% endif %}
      {% endif %}
      {% if entry.url %}
        <strong
          ><a href="{{ entry.url }}" target="_blank">{{ entry.name }}</a></strong
        >
      {% else %}
        <strong>{{ entry.name }}</strong>
      {% endif %}

      {% if entry.issuer %}
        - <em>{{ entry.issuer }}</em>
      {% endif %}

      {% if entry.date %}
        ({{ entry.date | split: '-' | slice: 0, 1 | join: '' }})
      {% endif %}
    </li>
  {% endfor %}
</ul>
